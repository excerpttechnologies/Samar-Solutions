# ---------------------------------------------------------------------------
# Initial administrator setup
# Used only by:
#   npm run admin:create
#   npm run admin:reset
# Never exposed to the browser.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# Optional server configuration
# ---------------------------------------------------------------------------
# SQLite database location, relative to the project root (default: data/samar.db)
# DATABASE_PATH=data/samar.db

# Admin session lifetime in hours (default: 8, maximum: 72)
# ADMIN_SESSION_HOURS=8

# Extra trusted origins for admin API requests, comma-separated.
# ADMIN_ALLOWED_ORIGINS=http://localhost:3000
